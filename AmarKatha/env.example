# Flask
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database — use PostgreSQL when running via Docker (see docker-compose.yml)
DATABASE_URL=postgresql://amarkatha_user:amarkatha_password@postgres:5432/amarkatha

# For non-Docker local runs with SQLite, use instead:
# DATABASE_URL=sqlite:///app.db

# Uploads (bytes) — 104857600 = 100MB per form submit (all files combined)
MAX_CONTENT_LENGTH=104857600
# MAX_UPLOAD_FILE_SIZE=104857600
UPLOAD_FOLDER=app/static/uploads

# PostgreSQL (Docker Compose defaults)
POSTGRES_DB=amarkatha
POSTGRES_USER=amarkatha_user
POSTGRES_PASSWORD=amarkatha_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Optional ports (override in .env if needed)
WEB_PORT=5000
REDIS_PORT=6379

# Redis (optional; not used by app code yet)
REDIS_URL=redis://redis:6379/0

# Google OAuth (optional — or use google_credentials.json in project root)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_INSECURE_TRANSPORT=true
APP_BASE_URL=http://localhost:5000
