# AmarKatha Java V0 — local development
# Copy to .env and adjust as needed (docker compose reads .env automatically)

SERVER_PORT=8080

# Host-native runs use localhost; Docker Compose sets POSTGRES_HOST=postgres for the app service
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=amarkatha
POSTGRES_USER=amarkatha
POSTGRES_PASSWORD=amarkatha

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Local redirect URI:  http://localhost:8080/login/oauth2/code/google
# Prod redirect URI:   https://YOUR_DOMAIN/login/oauth2/code/google
# Also add the matching origin under Authorized JavaScript origins.
# Compose uses placeholders if unset so the stack can boot; set real values for sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails promoted to ADMIN on Google sign-in (signup or login) — no separate admin login page
ADMIN_BOOTSTRAP_EMAILS=

# Public site origin (no trailing slash). Required for docker-compose.https.yml / prod profile.
# Local: leave empty (OG/share use request host). Prod example: https://amarkatha.example.com
AMARKATHA_PUBLIC_BASE_URL=

AMARKATHA_CONTACT_EMAIL=hello@amarkatha.in
AMARKATHA_GRIEVANCE_OFFICER=Founder (interim)

# Chapter page files. Local Spring Boot and Docker Compose both use this folder
# (Compose bind-mounts ./data/media → /data/media). Keep them in sync — do not
# mix a Docker-only named volume with a host-native app against the same DB.
AMARKATHA_MEDIA_ROOT=./data/media

# Delist chapters with missing media on boot / hourly schedule (set false to warn only on boot)
AMARKATHA_MEDIA_RECONCILE_ON_STARTUP=true
AMARKATHA_MEDIA_RECONCILE_SCHEDULE=true
# AMARKATHA_MEDIA_RECONCILE_INTERVAL_MS=3600000

# Chapter notification email.
# Docker Compose defaults to enabled + Mailpit (UI: http://localhost:8025).
# Host-native runs default to disabled; set enabled=true + SMTP_* to send.
# AMARKATHA_MAIL_ENABLED=true
AMARKATHA_MAIL_FROM=noreply@amarkatha.in
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Reader portal staged rollout (defaults keep anonymous reading available)
# AMARKATHA_READER_FEATURE_LANDING_DISCOVERY=true
# AMARKATHA_READER_FEATURE_PROFILE_PROGRESS=true
# AMARKATHA_READER_FEATURE_FOLLOWS=true
# AMARKATHA_READER_FEATURE_IN_APP_NOTIFICATIONS=true
# Defaults to AMARKATHA_MAIL_ENABLED when unset:
# AMARKATHA_READER_FEATURE_EMAIL_NOTIFICATIONS=false

# Prometheus + Grafana start with `docker compose up`
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
